{
  "name": "siscon-enosa-backend",
  "version": "1.0.0",
  "description": "API REST TPS SISCON-ENOSA - Operaciones / Medición Eléctrica",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
